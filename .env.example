# Non-secret settings only. Copy to .env (bootstrap.sh does this once). Secrets live in ./secrets/.
# The Claude API key is NOT configured here: add it after login in Settings › Claude connection.

# production | development | test. Only test/development may use MODEL_PROVIDER_MODE=mock.
APP_PROFILE=production
MODEL_PROVIDER_MODE=anthropic

# Public origin of the app exactly as the browser sees it (scheme://host[:port]).
APP_ORIGIN=http://127.0.0.1:8080
# Host interface and port for the web service. Keep 127.0.0.1 unless a reverse proxy/TLS sits in front.
APP_BIND=127.0.0.1
APP_PORT=8080

# Proxies trusted for X-Forwarded-* (Docker bridge + loopback by default).
TRUST_PROXY=loopback,uniquelocal
# Leave empty to derive from APP_ORIGIN (https => Secure cookies).
COOKIE_SECURE=

APP_VERSION=0.1.0
RUN_CONCURRENCY=2
LOG_LEVEL=info

# Production HTTPS (compose.production.yaml): your domain and ACME e-mail.
DOMAIN=
ACME_EMAIL=
